{
  "name": "cmake-build-test",
  "displayName": "CMake Build & Test",
  "description": "Сборка и запуск тестов CMake с визуализацией статистики",
  "version": "0.0.1",
  "publisher": "your-name",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cmakeBuildTest.run",
        "title": "CMake: Build & Test"
      },
      {
        "command": "cmakeBuildTest.dashboard",
        "title": "CMake: Show Test Dashboard"
      }
    ],
    "keybindings": [
      {
        "command": "cmakeBuildTest.run",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus"
      },
      {
        "command": "cmakeBuildTest.dashboard",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.x"
  },
  "dependencies": {
    "chart.js": "^4.6.1"
  }
}